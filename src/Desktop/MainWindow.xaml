<Window x:Class="Defuse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Defuse" Icon="Assets/defuse.ico" Height="820" Width="1180" MinWidth="920" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" Background="#FF171717"
        WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="10" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="HomePoster">
      <StackPanel Width="156">
        <Border Width="156" Height="234" CornerRadius="10" ClipToBounds="True" Background="#14FFFFFF">
          <Grid>
            <Image Source="{Binding Poster}" Stretch="UniformToFill"/>
            <ProgressBar VerticalAlignment="Bottom" Height="3" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         Foreground="#F2FFFFFF" Background="#66000000" BorderThickness="0"
                         Visibility="{Binding ShowBar}"/>
            <Button Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Click="DismissHome" Cursor="Hand" Focusable="False">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Dot" Background="#E0101010" CornerRadius="11" BorderBrush="#66FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="Mark" Text="&#x00D7;" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Dot" Property="Background" Value="#F0FFFFFF"/>
                      <Setter TargetName="Dot" Property="BorderBrush" Value="#F0FFFFFF"/>
                      <Setter TargetName="Mark" Property="Foreground" Value="#FF171717"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>
        <TextBlock Text="{Binding Title}" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Border x:Name="Tint" Background="#FF171717" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel>
            <Image DockPanel.Dock="Top" Source="Assets/defuse.png" Width="32" Height="32" Margin="0,10,0,6" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Defuse"/>
          <StackPanel Margin="0,4,0,12">
            <Button x:Name="HomeButton" Style="{StaticResource RailButton}" Content="&#xE80F;" ToolTip="Home" Click="ShowHome"/>
            <Button x:Name="LibraryButton" Style="{StaticResource RailButton}" Content="&#xE8F1;" ToolTip="Library" Click="ShowLibrary"/>
            <Button x:Name="SettingsButton" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Settings" Click="ShowSettings" Margin="0,16,0,0"/>
          </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="16,0,0,0">
            <TextBlock x:Name="SectionTitle" Text="Home" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
              <Button Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="Search" Click="OpenSearch" VerticalAlignment="Center" Margin="0,0,2,0"/>
              <Button Style="{StaticResource RailButton}" Content="&#xE710;" ToolTip="Add link" Click="OpenAdd" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeWindow"/>
              <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaximizeWindow"/>
              <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="CloseWindow"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <Grid x:Name="BrowsePanes">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="260"/>
                <ColumnDefinition x:Name="SplitColumn" Width="0"/>
                <ColumnDefinition x:Name="DetailColumn" Width="0" MinWidth="0"/>
              </Grid.ColumnDefinitions>
              <DockPanel Margin="8,0,0,8">
                <Grid>
                  <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Continue" Margin="16,12,12,8" Foreground="{StaticResource Muted}"/>
                    <ListBox x:Name="ContinueList" Grid.Row="1" VerticalAlignment="Top" Margin="12,0,12,0" MouseDoubleClick="PlaySelectedContinue"
                             ItemTemplate="{StaticResource HomePoster}" ItemContainerStyle="{StaticResource PosterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Library" Margin="16,18,12,8" Foreground="{StaticResource Muted}"/>
                    <ListBox x:Name="RecentList" Grid.Row="3" VerticalAlignment="Top" Margin="12,0,12,0" MouseDoubleClick="OpenSelectedRecent"
                             ItemTemplate="{StaticResource HomePoster}" ItemContainerStyle="{StaticResource PosterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock x:Name="DoneHeading" Grid.Row="4" Text="Done watching" Margin="16,18,12,8" Foreground="{StaticResource Muted}" Visibility="Collapsed"/>
                    <ListBox x:Name="DoneList" Grid.Row="5" VerticalAlignment="Top" Margin="12,0,12,0" MouseDoubleClick="OpenSelectedDone" Visibility="Collapsed"
                             ItemTemplate="{StaticResource HomePoster}" ItemContainerStyle="{StaticResource PosterItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                  </Grid>
                  </ScrollViewer>
                  <ScrollViewer x:Name="LibraryView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <DockPanel>
                      <Border DockPanel.Dock="Bottom" Margin="12,4,12,8" Padding="12" Background="{StaticResource Plate}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16">
                        <StackPanel>
                          <TextBlock Text="COLLECTIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Create" Click="CreateCollection" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="CollectionName"/>
                          </DockPanel>
                          <ListBox x:Name="CollectionList" Height="72" Margin="0,8,0,8"/>
                          <Button Content="Add selected title" Click="AddSelectedToCollection" HorizontalAlignment="Left"/>
                          <TextBlock Text="PLAYLISTS" Style="{StaticResource SectionLabel}"/>
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Create" Click="CreatePlaylist" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PlaylistName"/>
                          </DockPanel>
                          <ListBox x:Name="PlaylistList" Height="72" Margin="0,8,0,8"/>
                          <Button Content="Add selected title" Click="AddSelectedToPlaylist" HorizontalAlignment="Left"/>
                        </StackPanel>
                      </Border>
                      <ListBox x:Name="LibraryList" MouseDoubleClick="OpenSelectedLibrary" ItemTemplate="{StaticResource PosterTile}" ItemContainerStyle="{StaticResource PosterItem}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                      </ListBox>
                    </DockPanel>
                  </ScrollViewer>
                </Grid>
              </DockPanel>
              <Grid Grid.Column="1" Background="Transparent">
                <Border Width="1" Background="{StaticResource Line}" HorizontalAlignment="Center"/>
                <GridSplitter Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
              </Grid>
              <Grid Grid.Column="2" Margin="8,0,12,8">
                <TextBlock x:Name="EmptyDetail" Text="Select a title" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <ScrollViewer x:Name="DetailsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border Height="360" CornerRadius="12" ClipToBounds="True" Background="#14FFFFFF" Margin="0,0,0,16" Cursor="Hand" MouseLeftButtonUp="PlayDetails">
                      <Grid>
                        <Image x:Name="PosterImage" Stretch="UniformToFill"/>
                        <ProgressBar x:Name="DetailProgress" VerticalAlignment="Bottom" Height="4" Maximum="100"
                                     Foreground="#F2FFFFFF" Background="#66000000" BorderThickness="0"/>
                        <Button x:Name="PlayDetailButton" Content="Watch" Click="PlayDetails" HorizontalAlignment="Center" VerticalAlignment="Center"
                                FontSize="20" FontWeight="SemiBold" Padding="36,14" MinWidth="180"/>
                      </Grid>
                    </Border>
                    <TextBlock x:Name="DetailTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DetailMeta" Foreground="{StaticResource Muted}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailSource" Visibility="Collapsed"/>
                    <WrapPanel>
                      <Button x:Name="FavoriteButton" Content="Favorite" Click="ToggleFavorite"/>
                      <Button Content="Episodes" Click="OpenShowFromDetails"/>
                      <Button Content="Delete" Click="DeleteDetails"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="Look up poster" Click="LookupPoster"/>
                      <Button Content="Choose poster file" Click="ChoosePoster"/>
                    </WrapPanel>
                    <ListBox x:Name="MatchList" Height="120" MouseDoubleClick="ApplyPoster"/>
                    <DockPanel Margin="0,12,0,0">
                      <Button DockPanel.Dock="Right" Content="Save intro end" Click="SaveIntro" Margin="8,0,0,0"/>
                      <TextBox x:Name="IntroSeconds" ToolTip="Seconds from the start"/>
                    </DockPanel>
                  </StackPanel>
                </ScrollViewer>
                <DockPanel x:Name="ShowView" Visibility="Collapsed">
                  <TextBlock x:Name="ShowHeading" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center"/>
                  <Button DockPanel.Dock="Bottom" Content="Play next" HorizontalAlignment="Left" Click="PlayNext"/>
                  <ListBox x:Name="EpisodeList" MouseDoubleClick="PlaySelectedEpisode"/>
                </DockPanel>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="16,0,16,12">
              <Border MaxWidth="720" HorizontalAlignment="Left" Background="{StaticResource Plate}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16,8,16,16">
                <StackPanel>
                  <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="0,4,0,6"/>
                  <CheckBox x:Name="ClipboardWatch" Content="Watch the clipboard for a video link" Checked="SaveClipboard" Unchecked="SaveClipboard" Margin="0,0,0,10"/>
                  <Button Content="Scan a folder" HorizontalAlignment="Left" Click="ScanFolder"/>
                  <TextBlock Text="NETWORK" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Folder path" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="UncPath"/>
                  <TextBlock Text="User" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="UncUser"/>
                  <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="UncPassword"/>
                  <Button Content="Connect and scan" HorizontalAlignment="Left" Click="ConnectUnc" Margin="0,10,0,0"/>
                  <TextBlock Text="Mounted NFS folder" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="NfsPath"/>
                  <Button Content="Check and scan" HorizontalAlignment="Left" Click="ScanNfs" Margin="0,10,0,0"/>
                  <TextBlock Text="STREMIO" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Addon manifest" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="ManifestUrl"/>
                  <Button Content="Save addon" HorizontalAlignment="Left" Click="SaveAddon" Margin="0,10,0,8"/>
                  <ListBox x:Name="AddonList" Height="80"/>
                  <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="StremioType" Text="movie"/>
                  <TextBlock Text="Id" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="StremioId"/>
                  <Button Content="Find streams" HorizontalAlignment="Left" Click="FindStreams" Margin="0,10,0,8"/>
                  <ListBox x:Name="StreamList" Height="100" MouseDoubleClick="PlaySelectedStream"/>
                  <TextBlock Text="SERVERS" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Jellyfin address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="JellyfinUrl"/>
                  <TextBlock Text="Jellyfin user" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="JellyfinUser"/>
                  <TextBlock Text="Jellyfin password" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="JellyfinPassword"/>
                  <Button Content="List Jellyfin" HorizontalAlignment="Left" Click="ListJellyfin" Margin="0,10,0,8"/>
                  <ListBox x:Name="JellyfinList" Height="100" MouseDoubleClick="PlayJellyfin"/>
                  <TextBlock Text="Emby address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="EmbyUrl"/>
                  <TextBlock Text="Emby user" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="EmbyUser"/>
                  <TextBlock Text="Emby password" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="EmbyPassword"/>
                  <Button Content="List Emby" HorizontalAlignment="Left" Click="ListEmby" Margin="0,10,0,8"/>
                  <ListBox x:Name="EmbyList" Height="100" MouseDoubleClick="PlayEmby"/>
                  <TextBlock Text="Plex address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="PlexUrl"/>
                  <TextBlock Text="Plex token" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="PlexToken"/>
                  <Button Content="List Plex libraries" HorizontalAlignment="Left" Click="ListPlex" Margin="0,10,0,8"/>
                  <ListBox x:Name="PlexList" Height="80"/>
                  <TextBlock Text="WebDAV address" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="WebDavUrl"/>
                  <TextBlock Text="WebDAV user" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="WebDavUser"/>
                  <TextBlock Text="WebDAV password" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="WebDavPassword"/>
                  <Button Content="List WebDAV" HorizontalAlignment="Left" Click="ListWebDav" Margin="0,10,0,8"/>
                  <ListBox x:Name="WebDavList" Height="100" MouseDoubleClick="PlayWebDav"/>
                  <TextBlock Text="FTP host" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="FtpHost"/>
                  <TextBlock Text="FTP path" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="FtpPath"/>
                  <TextBlock Text="FTP user" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="FtpUser"/>
                  <TextBlock Text="The password is not put in the player link." Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  <Button Content="Save FTP link" HorizontalAlignment="Left" Click="SaveFtp" Margin="0,10,0,0"/>
                  <TextBlock Text="SFTP host" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="SftpHost"/>
                  <TextBlock Text="SFTP port" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="SftpPort" Text="22"/>
                  <TextBlock Text="SFTP user" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="SftpUser"/>
                  <TextBlock Text="SFTP password" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="SftpPassword"/>
                  <TextBlock Text="SFTP path" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="SftpPath"/>
                  <TextBlock Text="Listing stays here. Playback is not started, so the password is not handed to the player." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <Button Content="List SFTP" HorizontalAlignment="Left" Click="ListSftp" Margin="0,10,0,8"/>
                  <ListBox x:Name="SftpList" Height="80"/>
                  <TextBlock Text="KEYS" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="TMDB key" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="TmdbKey"/>
                  <TextBlock Text="Trakt token" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="TraktToken"/>
                  <Button Content="Save keys" HorizontalAlignment="Left" Click="SaveKeys" Margin="0,10,0,8"/>
                  <TextBlock x:Name="TmdbCredit" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                  <TextBlock Text="PROFILES" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="ProfileName"/>
                  <TextBlock Text="PIN" Style="{StaticResource FieldLabel}"/>
                  <PasswordBox x:Name="ProfilePin"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                    <Button Content="Create profile" Click="CreateProfile"/>
                    <Button Content="Switch" Click="SwitchProfile"/>
                    <Button Content="Set PIN" Click="SetProfilePin"/>
                  </StackPanel>
                  <ListBox x:Name="ProfileList" Height="100"/>
                  <Button Content="Export library without links" HorizontalAlignment="Left" Click="ExportLibrary" Margin="0,10,0,0"/>
                  <TextBlock x:Name="CloudNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                  <TextBlock Text="This build runs on Windows." Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                </StackPanel>
              </Border>
            </ScrollViewer>
          </Grid>
          <TextBlock x:Name="StatusText" Grid.Row="2" Margin="16,0,16,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </Grid>
      </Grid>

      <Grid x:Name="AddOverlay" Visibility="Collapsed" Background="{StaticResource Scrim}" MouseLeftButtonDown="CloseAdd">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" MouseLeftButtonDown="KeepScreenerOpen">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <Button DockPanel.Dock="Right" Style="{StaticResource PlayerIcon}" Width="28" Height="28" Content="&#xE711;" ToolTip="Close" Click="CloseAdd"/>
              <TextBlock Text="Add link" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="One link per line. The order you paste is the queue." Foreground="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <TextBox x:Name="AddUrl" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Save" Click="SaveAdd"/>
              <Button Content="Play once" Click="PlayOnce"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="SearchOverlay" Visibility="Collapsed" Background="{StaticResource Scrim}" MouseLeftButtonDown="CloseSearch">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Width="520" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" MouseLeftButtonDown="KeepScreenerOpen">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Style="{StaticResource PlayerIcon}" Width="28" Height="28" Content="&#xE711;" ToolTip="Close" Click="CloseSearch"/>
              <TextBlock Text="Search" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchChanged"/>
            <ListBox x:Name="SearchList" Margin="0,8,0,0" MouseDoubleClick="OpenSearchResult"/>
          </DockPanel>
        </Border>
      </Grid>

      <Grid x:Name="DetailSourceOverlay" Visibility="Collapsed" Background="{StaticResource Scrim}" MouseLeftButtonDown="CloseDetailSources">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" MouseLeftButtonDown="KeepScreenerOpen">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Sources" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Play" Click="PlayDetailSource"/>
              <Button Content="Close" Click="CloseDetailSources"/>
            </StackPanel>
            <ListBox x:Name="DetailSourceList"/>
          </DockPanel>
        </Border>
      </Grid>

      <Grid x:Name="ReplaceOverlay" Visibility="Collapsed" Background="{StaticResource Scrim}" MouseLeftButtonDown="CloseReplace">
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" MouseLeftButtonDown="KeepScreenerOpen">
          <StackPanel>
            <TextBlock Text="Replace link" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="The title and your place stay." Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
            <TextBox x:Name="ReplaceUrl"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Replace" Click="ApplyReplace"/>
              <Button Content="Close" Click="CloseReplace"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="PlayerLayer" Visibility="Collapsed" Background="#FF000000">
        <vlc:VideoView x:Name="Video">
          <Grid x:Name="Chrome" Background="#01000000" Focusable="True" ToolTipService.IsEnabled="False" MouseMove="ChromeMouseMove" MouseLeftButtonDown="ChromeDoubleClick" MouseLeftButtonUp="ChromePressUp" MouseRightButtonDown="ChromeRightDown" MouseRightButtonUp="ChromeRightUp" PreviewKeyDown="PlayerKey" PreviewKeyUp="PlayerKeyUp" PreviewGotKeyboardFocus="ChromeFocused">
            <Grid.Resources>
              <Style TargetType="Button">
                <Setter Property="Background" Value="{x:Null}"/>
                <Setter Property="BorderBrush" Value="{x:Null}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{StaticResource PlayerHit}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="LoadingWash" Grid.RowSpan="3" Background="#FF171717" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border Grid.RowSpan="3" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="30" Tag="tl" MouseLeftButtonDown="BeginCornerResize"/>
            <Border Grid.RowSpan="3" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="30" Tag="tr" MouseLeftButtonDown="BeginCornerResize"/>
            <Border Grid.RowSpan="3" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" Panel.ZIndex="30" Tag="bl" MouseLeftButtonDown="BeginCornerResize"/>
            <Border Grid.RowSpan="3" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" Panel.ZIndex="30" Tag="br" MouseLeftButtonDown="BeginCornerResize"/>
            <Grid Height="48" VerticalAlignment="Top">
              <Border Background="Transparent" MouseLeftButtonDown="BeginPlayerDrag" MouseMove="MovePlayerDrag" MouseLeftButtonUp="EndPlayerDrag"/>
              <DockPanel x:Name="PlayerHeader" Margin="60,0,16,0" VerticalAlignment="Center" MouseLeftButtonDown="BeginPlayerDrag" MouseMove="MovePlayerDrag" MouseLeftButtonUp="EndPlayerDrag">
                <TextBlock x:Name="PlayerTitle" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                <TextBlock x:Name="PlayerEpisode" Visibility="Collapsed"/>
              </DockPanel>
              <Button x:Name="PlayerBack" Style="{StaticResource PlayerIcon}" Click="LeavePlayer" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" Panel.ZIndex="5" Width="40" Height="40">
                <Viewbox Width="20" Height="20">
                  <Canvas Width="24" Height="24">
                    <Path Style="{StaticResource PlayerGlyph}" Data="M12,19 L5,12 L12,5"/>
                    <Path Style="{StaticResource PlayerGlyph}" Data="M19,12 H5"/>
                  </Canvas>
                </Viewbox>
              </Button>
            </Grid>
            <Grid Grid.Row="1">
              <Border x:Name="StatsPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0" Background="#E0101010" Padding="14,6,6,10" MinWidth="560" Visibility="Collapsed" Panel.ZIndex="4">
                <Grid>
                  <Button Style="{StaticResource PlayerIcon}" Content="&#xE711;" Click="CloseStats" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1"/>
                  <Grid Margin="0,4,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="168"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Viewport / Frames" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsViewport" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="1" Text="Current / Optimal Res" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsResolution" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="2" Text="Volume" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsVolume" Grid.Row="2" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="3" Text="Codecs" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsCodecs" Grid.Row="3" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="4" Text="Connection Speed" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsSpeed" Grid.Row="4" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="5" Text="Network Activity" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsNetwork" Grid.Row="5" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                    <TextBlock Grid.Row="6" Text="Buffer Health" Foreground="White" FontSize="13" Margin="0,1"/>
                    <TextBlock x:Name="StatsBuffer" Grid.Row="6" Grid.Column="1" Foreground="White" FontSize="13" HorizontalAlignment="Right" Margin="16,1,28,1" Text="—"/>
                  </Grid>
                </Grid>
              </Border>
              <Border x:Name="SeekingMark" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#CC171717" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20" Padding="18,10" Panel.ZIndex="6">
                <TextBlock Text="Loading" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
              </Border>
              <Border x:Name="KeyGuide" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F0171717" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,16" MinWidth="340" Panel.ZIndex="7">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Keyboard" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                  <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="KeyList"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <TextBlock x:Name="CenterFeedback" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Foreground="White" Visibility="Collapsed"/>
              <Border x:Name="FailurePanel" Background="#F010141C" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="12">
                <StackPanel>
                  <TextBlock x:Name="FailureText" TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,12" Foreground="White"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Retry" Click="RetryPlayback"/>
                    <Button Content="Replace link" Click="OpenPlayerReplace"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="PlayerSourcePanel" Background="#F010141C" Padding="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,8" Width="320" MaxHeight="240" Visibility="Collapsed" CornerRadius="12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Sources" Margin="0,0,0,8" Foreground="White"/>
                  <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Left" Click="ClosePlayerSources"/>
                  <ListBox x:Name="PlayerSourceList" MouseDoubleClick="PlayPlayerSource"/>
                </DockPanel>
              </Border>
              <Border x:Name="MorePanel" Background="#F010141C" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,8" Width="300" MaxHeight="460" Visibility="Collapsed" CornerRadius="12">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlayerIcon}" Content="&#xE711;" Click="CloseMore" Width="28" Height="28"/>
                    <TextBlock x:Name="MenuTitle" Text="Playback" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                  </DockPanel>
                  <StackPanel x:Name="MenuHome" Visibility="Collapsed"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
                  <StackPanel x:Name="MenuBody" Visibility="Collapsed">
                    <TextBlock x:Name="InfoText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="White" Visibility="Collapsed"/>
                    <TextBlock x:Name="SubtitleNote" Text="" Visibility="Collapsed"/>
                    <ListBox x:Name="RateList" MaxHeight="140" SelectionChanged="ApplyRate"/>
                    <ListBox x:Name="AudioList" MaxHeight="180" SelectionChanged="ApplyAudio"/>
                    <ListBox x:Name="SubtitleTrackList" MaxHeight="140" SelectionChanged="ApplySubtitleTrack"/>
                    <StackPanel x:Name="SubtitleStyle" Margin="0,10,0,0" Visibility="Collapsed">
                      <TextBlock Text="Size" Foreground="#F2FFFFFF" Margin="0,0,0,4"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="−" Tag="-1" PreviewMouseLeftButtonDown="SizeHoldStart" PreviewMouseLeftButtonUp="SizeHoldStop" MouseLeave="SizeHoldLeave" Padding="16,6"/>
                        <TextBox x:Name="SubtitleSizeLabel" Text="100" Width="64" Margin="6,0" Padding="4,4" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="4" PreviewTextInput="SubtitleSizeTyping" LostFocus="SubtitleSizeCommit" KeyDown="SubtitleSizeKey"/>
                        <Button Content="+" Tag="1" PreviewMouseLeftButtonDown="SizeHoldStart" PreviewMouseLeftButtonUp="SizeHoldStop" MouseLeave="SizeHoldLeave" Padding="16,6"/>
                      </StackPanel>
                      <TextBlock Text="Color" Foreground="#F2FFFFFF" Margin="0,8,0,4"/>
                      <Slider x:Name="SubtitleHue" Style="{StaticResource HueSlider}" ValueChanged="SubtitleHueChanged" PreviewMouseLeftButtonUp="SubtitleColorCommit"/>
                      <DockPanel Margin="0,8,0,0">
                        <Border x:Name="SubtitleSwatch" DockPanel.Dock="Right" Width="18" Height="18" Margin="8,0,0,0" CornerRadius="4" Background="White" VerticalAlignment="Center"/>
                        <Slider x:Name="SubtitleSaturation" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="100" Value="0" ValueChanged="SubtitleSaturationChanged" PreviewMouseLeftButtonUp="SubtitleColorCommit"/>
                      </DockPanel>
                    </StackPanel>
                    <DockPanel x:Name="SubtitleDelayRow" Margin="0,8,0,0" Visibility="Collapsed">
                      <TextBlock DockPanel.Dock="Left" Text="Delay" VerticalAlignment="Center" Width="48" Foreground="White"/>
                      <Slider x:Name="SubtitleDelaySlider" Style="{StaticResource PlayerSlider}" Minimum="-5000" Maximum="5000" Value="0" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SubtitleDelayChanged"/>
                    </DockPanel>
                    <ListBox x:Name="ChapterList" MaxHeight="140" MouseDoubleClick="ApplyChapter"/>
                    <Button x:Name="StartOverButton" Content="Start over" Click="StartOver" Visibility="Collapsed" HorizontalAlignment="Left"/>
                    <Button x:Name="IntroMarkButton" Content="Mark intro end" Click="MarkIntroFromPlayer" Visibility="Collapsed" HorizontalAlignment="Left"/>
                    <Button x:Name="CreditsMarkButton" Content="Mark credits" Click="MarkCredits" Visibility="Collapsed" HorizontalAlignment="Left"/>
                  </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Border x:Name="QueuePanel" Grid.Row="1" Background="#F010141C" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0" Width="420" MaxHeight="520" Visibility="Collapsed" CornerRadius="12">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PlayerIcon}" Content="&#xE711;" Click="CloseQueue" Width="28" Height="28"/>
                    <TextBlock x:Name="QueueHeading" Text="Queue" FontSize="20" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                  </DockPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="QueueRows"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>
              <Button x:Name="NextEpisodeButton" Grid.Row="1" Click="PlayQueueNext" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,60" Padding="0">
                <Border Background="#E0101010" CornerRadius="8" Padding="14,8">
                  <TextBlock Text="Next" Foreground="White" FontSize="14"/>
                </Border>
              </Button>
              <Border x:Name="PlayerReplacePanel" Background="#F010141C" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="12">
                <StackPanel Width="420">
                  <TextBlock Text="Replace link" Margin="0,0,0,8" Foreground="White"/>
                  <TextBox x:Name="PlayerReplaceUrl"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Replace and keep place" Click="ApplyPlayerReplace"/>
                    <Button Content="Close" Click="ClosePlayerReplace"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="2">
              <Border Height="28" VerticalAlignment="Bottom" Background="Transparent" MouseLeftButtonDown="BeginPlayerDrag" MouseMove="MovePlayerDrag" MouseLeftButtonUp="EndPlayerDrag"/>
              <StackPanel x:Name="PlayerBar" HorizontalAlignment="Center" Width="860" Margin="0,0,0,28">
              <Button x:Name="SkipIntroButton" Content="Skip intro" HorizontalAlignment="Left" Margin="8,0,0,8" Visibility="Collapsed" Click="SkipIntro"/>
              <Border x:Name="SeekHint" Background="#E0101014" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="SeekHintText" Foreground="White"/>
              </Border>
              <Grid>
                <Border x:Name="PlayerVeil" CornerRadius="22" Background="#4A101010" IsHitTestVisible="False"/>
                <Border x:Name="PlayerBlur" CornerRadius="22" Opacity="0.34" IsHitTestVisible="False"/>
              <Border x:Name="PlayerPlate" CornerRadius="22" BorderThickness="0" Background="Transparent" Padding="14,6,14,8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <StackPanel x:Name="QueueActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="QueueSkip" Style="{StaticResource PlayerBarIcon}" Click="PlayQueueNext" VerticalAlignment="Center">
                          <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                              <Path Fill="White" Data="M5,5 L5,19 L14,12 Z"/>
                              <Path Style="{StaticResource PlayerGlyph}" Data="M17,5 V19"/>
                            </Canvas>
                          </Viewbox>
                        </Button>
                        <Button x:Name="QueueOpen" Style="{StaticResource PlayerBarIcon}" Click="OpenQueue" VerticalAlignment="Center">
                          <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                              <Path Style="{StaticResource PlayerGlyph}" Data="M8,8 H20 V18 H8 Z"/>
                              <Path Style="{StaticResource PlayerGlyph}" Data="M4,6 H16 V8"/>
                              <Path Style="{StaticResource PlayerGlyph}" Data="M4,6 V16 H8"/>
                            </Canvas>
                          </Viewbox>
                        </Button>
                      </StackPanel>
                      <Slider x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}" Width="96" Minimum="0" Maximum="100" Value="100" ValueChanged="VolumeChanged" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Style="{StaticResource PlayerSideIcon}" Click="FocusAudio">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M3,14 H6 A2,2 0 0 1 8,16 V19 A2,2 0 0 1 6,21 H5 A2,2 0 0 1 3,19 V12 A9,9 0 0 1 21,12 V19 A2,2 0 0 1 19,21 H18 A2,2 0 0 1 16,19 V16 A2,2 0 0 1 18,14 H21"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Style="{StaticResource PlayerSideIcon}" Click="FocusSubtitles">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M5,5 H19 A2,2 0 0 1 21,7 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 V7 A2,2 0 0 1 5,5 Z"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M7,15 H11 M15,15 H17 M7,11 H9 M13,11 H17"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Style="{StaticResource PlayerSideIcon}" Click="OpenSpeed">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M12,14 L16,10"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M3.34,19 A10,10 0 1 1 20.66,19"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button x:Name="StatsButton" Style="{StaticResource PlayerSideIcon}" Click="ToggleStats">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M5,21 V15"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M12,21 V3"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M19,21 V9"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button x:Name="CompactButton" Style="{StaticResource PlayerSideIcon}" Click="ToggleCompact">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M21,9 V6 A2,2 0 0 0 19,4 H4 A2,2 0 0 0 2,6 V16 A2,2 0 0 0 4,18 H8"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M14,13 H20 A2,2 0 0 1 22,15 V18 A2,2 0 0 1 20,20 H14 A2,2 0 0 1 12,18 V15 A2,2 0 0 1 14,13 Z"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button Style="{StaticResource PlayerSideIcon}" Click="ToggleFullScreen">
                        <Viewbox Width="18" Height="18">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M8,3 H5 A2,2 0 0 0 3,5 V8"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M21,8 V5 A2,2 0 0 0 19,3 H16"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M3,16 V19 A2,2 0 0 0 5,21 H8"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M16,21 H19 A2,2 0 0 0 21,19 V16"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="1">
                      <Button Style="{StaticResource PlayerBarIcon}" Click="SkipBackward">
                        <Viewbox Width="22" Height="22">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M7,9 L4,6 L7,3"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M15.997,17.918 A6.002,6.002 0 0 0 15,6 H4"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M6,14 V20"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M9,15.5 V18.5 A1.5,1.5 0 0 0 12,18.5 V15.5 A1.5,1.5 0 0 0 9,15.5"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                      <Button x:Name="PauseButton" Style="{StaticResource PlayerBarIcon}" Click="TogglePause">
                        <Grid Width="22" Height="22">
                          <Viewbox x:Name="PauseIcon">
                            <Canvas Width="24" Height="24">
                              <Rectangle Canvas.Left="5" Canvas.Top="4" Width="5" Height="16" RadiusX="1" RadiusY="1" Fill="White"/>
                              <Rectangle Canvas.Left="14" Canvas.Top="4" Width="5" Height="16" RadiusX="1" RadiusY="1" Fill="White"/>
                            </Canvas>
                          </Viewbox>
                          <Viewbox x:Name="PlayIcon" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                              <Path Fill="White" Data="M5,5 A2,2 0 0 1 8.008,3.272 L20.005,10.27 A2,2 0 0 1 20.008,13.728 L8.008,20.728 A2,2 0 0 1 5,19 Z"/>
                            </Canvas>
                          </Viewbox>
                        </Grid>
                      </Button>
                      <Button Style="{StaticResource PlayerBarIcon}" Click="SkipForward">
                        <Viewbox Width="22" Height="22">
                          <Canvas Width="24" Height="24">
                            <Path Style="{StaticResource PlayerGlyph}" Data="M17,9 L20,6 L17,3"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M8,17.918 A5.997,5.997 0 0 1 3,12 A6,6 0 0 1 9,6 H20"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M12,14 V20"/>
                            <Path Style="{StaticResource PlayerGlyph}" Data="M15,15.5 V18.5 A1.5,1.5 0 0 0 18,18.5 V15.5 A1.5,1.5 0 0 0 15,15.5"/>
                          </Canvas>
                        </Viewbox>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="1" Margin="2,6,2,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeCurrent" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <ProgressBar x:Name="BufferBar" Height="3" VerticalAlignment="Center" Background="Transparent" Foreground="#66FFFFFF" Visibility="Collapsed" Margin="0,0,0,0"/>
                      <Slider x:Name="SeekBar" Style="{StaticResource PlayerSlider}" Minimum="0" Maximum="1" ValueChanged="SeekChanged"/>
                    </Grid>
                    <TextBlock x:Name="TimeRemaining" Grid.Column="2" Foreground="White" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </Grid>
                </Grid>
              </Border>
              </Grid>
            </StackPanel>
            </Grid>
          </Grid>
        </vlc:VideoView>
      </Grid>
    </Grid>
  </Border>
</Window>
